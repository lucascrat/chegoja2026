# ============================================================
# CHEGOJÁ — Variáveis de Ambiente (Exemplo)
# ============================================================
# Copie este arquivo para .env.client, .env.driver, .env.admin
# e preencha com os valores reais.
# NUNCA commite os .env preenchidos.
# ============================================================

# Papel do build: client | driver | admin
VITE_APP_ROLE=client

# Supabase (self-hosted)
VITE_SUPABASE_URL=https://supabase.appbr.pro
VITE_SUPABASE_ANON_KEY=sua_anon_key_aqui

# Mapbox
VITE_MAPBOX_TOKEN=seu_mapbox_token_aqui

# (Opcional) Google Maps API Key — não usado mais, mantido por compatibilidade
VITE_GOOGLE_MAPS_API_KEY=

# (Opcional) Código da conta Efí Pay para tokenização de cartão
VITE_EFI_ACCOUNT_CODE=

# (Opcional) URL do payment-manager para builds nativos
VITE_VPS_PAYMENT_URL=http://seu-servidor:3000/payment-manager

# ── Apenas para desenvolvimento ──────────────────────────────
# Auto-login de teste (apenas em desenvolvimento)
VITE_DEV_AUTO_LOGIN=false
VITE_TEST_CLIENT_NAME=Cliente Teste
VITE_TEST_CLIENT_PHONE=(11) 91111-0001
VITE_TEST_DRIVER_USER=motorista.teste
VITE_TEST_DRIVER_PASS=Teste@2026
